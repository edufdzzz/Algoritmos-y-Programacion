Algoritmo suma_producto_promedio
	Definir num1,num2,num3 como entero
	definir suma,producto Como Real
	Definir promedio como entero
	
	Escribir "ingresa el valor1"
	Leer num1
	Escribir "ingresa el valor3"
	Leer num2
	escribir "ingresa el valor3"
	leer num3
	
	suma = num1+num2+num3 
	producto= num1*num2*num3
	promedio= suma/3
	Escribir "//////////////////////////////////////////////"
	Escribir "la suma es: ", suma
	Escribir "el producto es: ", producto
	Escribir "lel promedio es: ", promedio
	
FinAlgoritmo
