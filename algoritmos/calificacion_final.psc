Algoritmo calificacion_final
	Escribir "escribe tu calificacion del primer parcial (del 0 al 20)"
	leer p1
	Escribir "escribe tu calificacion del segundo parcial  (del 0 al 20)"
	leer p2
	Escribir "escribe tu calificacion de tus practicas  (del 0 al 35)"
	leer p
	Escribir "escribe tu calificacion del parcial final  (del 0 al 25)"
	leer pf
	ct= p1+p2+p+pf
	Escribir "su calificacion final es ", ct
	
	
	
FinAlgoritmo
